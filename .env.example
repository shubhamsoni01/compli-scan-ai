# ==========================================
# CompliScan AI Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env with secret keys.
# ==========================================

# 1. OCR.Space API Key (Free tier from https://ocr.space/ocrapi)
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# 2. Groq Cloud API Key (From https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 3. Server Port
PORT=5000

# 4. MongoDB Atlas Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/compliscan_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/compliscan_ai?retryWrites=true&w=majority

# 5. JWT Secret Key (Used for hashing and verifying session tokens)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# 6. Optional: Frontend Production Origin for strict CORS (e.g., https://compli-scan-ai.vercel.app)
CLIENT_ORIGIN=https://your-vercel-app.vercel.app

# 7. Frontend Environment Variables (Vite client-side)
# If backend is hosted separately (e.g. Render, Railway), set this in Vercel:
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
